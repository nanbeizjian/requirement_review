# Requirement Review API — environment template
# Copy to `.env` (gitignored) and fill in real values, or `export` in your shell.

# ---- LangSmith trace export --------------------------------------------
# When LANGCHAIN_TRACING_V2=true, every LangGraph / LangChain call (and any
# @traceable-decorated function) is uploaded to the LangSmith project named
# below. Auto-detected by langchain-core / langgraph; no Python change needed.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_replace_with_real_key
LANGCHAIN_PROJECT=requirement-review
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com   # default; override only for EU region

# ---- Storage ----------------------------------------------------------
# Switch the InMemoryApplicationServices runtime to the database-backed
# adapter by setting DATABASE_URL; alembic migrations live in `alembic/`.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/requirement_review
